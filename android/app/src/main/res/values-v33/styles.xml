<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Request the brand mark even when Android 13+ could choose an empty splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
